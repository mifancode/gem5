        <mxCell id="memctrl" value="内存控制器&#xa;MemCtrl → DRAMInterface&#xa;（时序/带宽/刷新）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane3">
