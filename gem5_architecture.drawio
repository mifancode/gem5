        <mxCell id="dev" value="设备 Dev&#xa;磁盘 / 网卡 / PCI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane3">
