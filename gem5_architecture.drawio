<mxfile host="app.diagrams.net" agent="gem5-talk" version="24.0.0">
  <diagram id="gem5-arch" name="gem5-architecture">
    <mxGraphModel dx="1240" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="800" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="gem5 工作原理 —— 模块化组件 + 事件驱动仿真" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1240" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="lane1" value="① 配置层（Python 脚本）" style="swimlane;startSize=28;fillColor=#fff9e6;strokeColor=#d6b656;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="40" width="1240" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="cfg" value="configs/*.py&#xa;用户 Python 配置脚本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="lane1">
          <mxGeometry x="60" y="45" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="tree" value="实例化 SimObject 树&#xa;System → CPU → Cache → MemCtrl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="lane1">
          <mxGeometry x="540" y="45" width="340" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="lane2" value="② 仿真内核（C++，事件驱动）" style="swimlane;startSize=28;fillColor=#e8f4f8;strokeColor=#6c8ebf;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="190" width="1240" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="evq" value="事件驱动引擎 EventQueue&#xa;每个 tick 取最早事件执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="lane2">
          <mxGeometry x="330" y="45" width="380" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="clk" value="CurTick / ClockDomain&#xa;时序推进（cycle-accurate）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane2">
          <mxGeometry x="780" y="45" width="220" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="lane3" value="③ 组件层（SimObject，可替换模块）" style="swimlane;startSize=28;fillColor=#f5f5f5;strokeColor=#666666;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="340" width="1240" height="280" as="geometry"/>
