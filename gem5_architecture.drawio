          <mxGeometry x="40" y="50" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="cache" value="缓存层次&#xa;L1 I$/D$ → L2&#xa;（大小/替换策略可配）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane3">
          <mxGeometry x="300" y="50" width="210" height="110" as="geometry"/>
